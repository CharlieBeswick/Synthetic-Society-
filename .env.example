HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./data/messages.sqlite
# Public HTTP(S) origin, e.g. https://your-domain.example (no path).
# Leave blank locally; sitemap returns 503 until configured.
PUBLIC_SITE_URL=
# Netlify only: optional site-wide store name (set in Netlify UI, Functions scope).
# BLOBS_STORE_NAME=synthetic-society-messages
# Set to 1 only behind the single local reverse proxy described in README.
TRUST_PROXY=0
