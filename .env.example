HOST=127.0.0.1
PORT=3000
# Public HTTP(S) origin, e.g. https://your-domain.example (no path).
# Leave blank locally; sitemap returns 503 until configured.
PUBLIC_SITE_URL=
# Set to 1 only behind the single local reverse proxy described in README.
TRUST_PROXY=0
# PostgreSQL is the only application database. The app refuses to start when this is missing.
# Use the Neon pooled connection for the running app and the direct connection for migrations.
# DATABASE_URL=postgres://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgres://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require
# MAINTENANCE_MODE=1
