{
  "name": "synthetic-society-interaction-test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A minimal experiment in AI website interaction",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/schema.js migrate",
    "db:status": "node --env-file-if-exists=.env src/schema.js status",
    "db:export": "node --env-file-if-exists=.env src/transfer-cli.js export",
    "db:import": "node --env-file-if-exists=.env src/transfer-cli.js import",
    "db:verify": "node --env-file-if-exists=.env src/transfer-cli.js verify",
    "test": "node --test",
    "build": "npm test"
  },
  "dependencies": {
    "@netlify/aws-lambda-compat": "^2.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "pg": "^8.23.1",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "robots-parser": "^3.0.1"
  }
}
